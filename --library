    <style>
      /* ═══════════════════════════════════════════════════════
         Style Guide Page Styles
         ═══════════════════════════════════════════════════════ */
      body {
        margin: 0;
        background: var(--background);
        color: var(--foreground);
        font-family: var(--font-serif);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      .shell-layout {
        display: flex;
        min-height: 100vh;
      }

      /* ── Sidebar (same as bookshelf) ────────────────────────── */
      .shell-sidebar {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 40;
        display: flex;
        flex-direction: column;
        width: 256px;
        height: 100vh;
        background: var(--sidebar);
        border-right: 1px solid var(--sidebar-border);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .shell-sidebar-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 28px 24px 24px;
        border-bottom: 1px solid var(--sidebar-border);
      }
      .shell-brand-mark {
        width: 32px;
        height: 32px;
        border-radius: var(--radius-sm);
        background: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--primary-foreground);
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 18px;
        flex-shrink: 0;
      }
      .shell-brand-name {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 22px;
        color: var(--sidebar-foreground);
        letter-spacing: -0.01em;
      }
      .sidebar-search {
        display: flex;
        align-items: center;
        gap: calc(var(--spacing) * 1.5);
        margin: 12px 12px 4px;
        padding: calc(var(--spacing) * 2) calc(var(--spacing) * 3);
        background: var(--muted);
        border: 1px solid transparent;
        border-radius: var(--radius-full);
        transition: background-color 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
      }
      .sidebar-search:focus-within {
        border-color: var(--ring);
        box-shadow: var(--shadow-xs);
        background: var(--popover);
      }
      .sidebar-search [data-icon] {
        width: 14px;
        height: 14px;
        flex-shrink: 0;
        color: var(--muted-foreground);
      }
      .sidebar-search input {
        flex: 1;
        min-width: 0;
        border: none;
        background: transparent;
        outline: none;
        color: var(--foreground);
        font-family: var(--font-sans);
        font-size: 12px;
      }
      .sidebar-search input::placeholder {
        color: var(--muted-foreground);
        font-size: 12px;
      }
      .shell-nav {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 16px 12px;
        overflow-y: auto;
      }
      .shell-nav-group-label {
        font-family: var(--font-sans);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted-foreground);
        padding: 8px 12px 8px;
        margin-top: 8px;
      }
      .shell-nav-item {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        padding: 10px 12px;
        border: 1px solid transparent;
        border-radius: calc(var(--radius) - 8px);
        background: transparent;
        color: var(--sidebar-foreground);
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.16s ease, color 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
        text-decoration: none;
      }
      .shell-nav-item:hover {
        background: var(--sidebar-accent);
        color: var(--sidebar-accent-foreground);
      }
      .shell-nav-item:focus-visible {
        outline: 2px solid var(--sidebar-ring);
        outline-offset: 2px;
      }
      .shell-nav-item.active {
        background: var(--primary);
        color: var(--primary-foreground);
        border-color: transparent;
        box-shadow: var(--shadow-xs);
      }
      .shell-nav-item [data-icon] {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
      }
      .sidebar-stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: calc(var(--spacing) * 2);
        padding: 12px 20px;
        border-top: 1px solid var(--sidebar-border);
      }
      .sidebar-stat {
        display: flex;
        flex-direction: column;
        gap: 1px;
      }
      .sidebar-stat-num {
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 16px;
        line-height: 1.2;
        color: var(--sidebar-foreground);
        font-variant-numeric: tabular-nums;
      }
      .sidebar-stat-label {
        font-family: var(--font-sans);
        font-size: 11px;
        font-weight: 400;
        color: var(--muted-foreground);
      }
      .sidebar-recycle-link {
        padding: 4px 20px 0;
      }
      .sidebar-recycle-link a:hover {
        color: var(--foreground) !important;
      }
      .shell-sidebar-footer {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 12px 12px 20px;
        border-top: 1px solid var(--sidebar-border);
      }
      .shell-footer-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 12px;
        border: 1px solid transparent;
        border-radius: calc(var(--radius) - 8px);
        background: transparent;
        color: var(--sidebar-foreground);
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.16s ease, color 0.16s ease;
        text-decoration: none;
      }
      .shell-footer-row:hover {
        background: var(--sidebar-accent);
        color: var(--sidebar-accent-foreground);
      }
      .shell-footer-row [data-icon] {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
      }
      .shell-avatar {
        width: 28px;
        height: 28px;
        border-radius: var(--radius-full);
        background: var(--bg-300);
        border: 2px solid var(--border-300);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--muted-foreground);
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 600;
      }
      .shell-user-info {
        flex: 1;
        min-width: 0;
      }
      .shell-user-name {
        font-size: 13px;
        font-weight: 500;
        color: var(--sidebar-foreground);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .shell-user-role {
        font-size: 11px;
        color: var(--muted-foreground);
      }

      /* ── Main Content ──────────────────────────────────────── */
      .shell-main {
        flex: 1;
        margin-left: 256px;
        min-height: 100vh;
        padding: 32px 40px;
        max-width: 100%;
        overflow-x: hidden;
      }

      /* ── Mobile Bottom Tab Bar ──────────────────────────────── */
      .shell-mobile-tabs {
        display: none;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 40;
        border-top: 1px solid var(--sidebar-border);
        background: var(--sidebar);
        box-shadow: 0 -1px 3px 0 rgba(0,0,0,0.06);
      }
      .shell-mobile-tabs-inner {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 4px;
        padding: 8px 12px calc(8px + env(safe-area-inset-bottom, 0px));
      }
      .shell-mobile-tab {
        display: grid;
        gap: 3px;
        justify-items: center;
        padding: 8px 4px;
        border: none;
        border-radius: calc(var(--radius) - 6px);
        background: transparent;
        color: var(--sidebar-foreground);
        font-family: var(--font-sans);
        font-size: 11px;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.16s ease, color 0.16s ease;
        text-decoration: none;
      }
      .shell-mobile-tab [data-icon] {
        width: 20px;
        height: 20px;
      }
      .shell-mobile-tab:hover {
        background: var(--sidebar-accent);
        color: var(--sidebar-accent-foreground);
      }
      .shell-mobile-tab.active {
        color: var(--primary);
      }

      /* ── Responsive ─────────────────────────────────────────── */
      @media (max-width: 768px) {
        .shell-sidebar {
          transform: translateX(-100%);
        }
        .shell-sidebar.is-open {
          transform: translateX(0);
          box-shadow: var(--shadow-xl);
        }
        .shell-sidebar-backdrop {
          display: none;
          position: fixed;
          inset: 0;
          z-index: 35;
          background: rgba(0,0,0,0.3);
        }
        .shell-sidebar-backdrop.is-visible {
          display: block;
        }
        .shell-main {
          margin-left: 0;
          padding: 20px 16px 88px;
        }
        .shell-mobile-tabs {
          display: block;
        }
        .sidebar-search {
          margin: 8px 8px 4px;
        }
      }

      /* ═══════════════════════════════════════════════════════
         Style Guide Content Styles
         ═══════════════════════════════════════════════════════ */
      .sg-page {
        max-width: 960px;
        display: flex;
        flex-direction: column;
        gap: 0;
      }

      .sg-page-header {
        margin-bottom: 48px;
      }
      .sg-page-title {
        margin: 0 0 6px;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 24px;
        line-height: 1.2;
        letter-spacing: -0.01em;
        color: var(--foreground);
      }
      .sg-page-subtitle {
        margin: 0;
        font-family: var(--font-serif);
        font-size: 13px;
        color: var(--muted-foreground);
      }

      /* ── Section ──────────────────────────────────────────── */
      .sg-section {
        padding: 48px 0;
        border-bottom: 1px solid var(--border);
      }
      .sg-section:last-child {
        border-bottom: none;
      }
      .sg-section-title {
        margin: 0 0 6px;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 20px;
        line-height: 1.3;
        color: var(--foreground);
      }
      .sg-section-desc {
        margin: 0 0 32px;
        font-family: var(--font-serif);
        font-size: 14px;
        color: var(--muted-foreground);
        line-height: 1.6;
      }

      /* ── Swatch grid ─────────────────────────────────────── */
      .sg-swatch-row {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        align-items: flex-start;
      }
      .sg-swatch {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
      }
      .sg-swatch-circle {
        width: 48px;
        height: 48px;
        border-radius: var(--radius-md);
        border: 1px solid var(--border-200);
        flex-shrink: 0;
      }
      .sg-swatch-label {
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--muted-foreground);
        text-align: center;
        line-height: 1.4;
        white-space: nowrap;
      }
      .sg-swatch-hex {
        font-family: var(--font-mono);
        font-size: 9px;
        color: var(--text-400);
      }

      /* ── Typography samples ──────────────────────────────── */
      .sg-type-group {
        margin-bottom: 32px;
      }
      .sg-type-group:last-child {
        margin-bottom: 0;
      }
      .sg-type-label {
        font-family: var(--font-sans);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted-foreground);
        margin: 0 0 16px;
      }
      .sg-type-sample {
        margin: 0 0 4px;
        line-height: 1.4;
      }
      .sg-type-meta {
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--text-400);
        margin: 0;
      }
      .sg-type-divider {
        height: 1px;
        background: var(--border);
        margin: 24px 0;
        border: none;
      }

      /* ── Component row ────────────────────────────────────── */
      .sg-comp-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
      }
      .sg-comp-group {
        margin-bottom: 24px;
      }
      .sg-comp-group:last-child {
        margin-bottom: 0;
      }
      .sg-comp-label {
        font-family: var(--font-sans);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted-foreground);
        margin: 0 0 12px;
      }

      /* ── Buttons ─────────────────────────────────────────── */
      .btn {
        appearance: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 36px;
        padding: 0 16px;
        border: 1px solid transparent;
        border-radius: var(--radius-sm);
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: background-color .16s ease, color .16s ease, border-color .16s ease, box-shadow .16s ease;
        text-decoration: none;
        white-space: nowrap;
      }
      .btn:focus-visible {
        outline: 2px solid var(--ring);
        outline-offset: 2px;
      }
      .btn-primary {
        background: var(--primary);
        color: var(--primary-foreground);
        border-color: var(--primary);
      }
      .btn-primary:hover {
        background: var(--brand-600);
        border-color: var(--brand-600);
      }
      .btn-primary:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        background: var(--primary);
      }
      .btn-secondary {
        background: transparent;
        color: var(--foreground);
        border-color: var(--border);
      }
      .btn-secondary:hover {
        background: var(--accent);
      }
      .btn-secondary:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }
      .btn-ghost {
        background: transparent;
        color: var(--muted-foreground);
        border-color: transparent;
        padding: 0 8px;
      }
      .btn-ghost:hover {
        color: var(--destructive);
        background: var(--error-50);
      }
      .btn-icon {
        width: 36px;
        height: 36px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        background: transparent;
        color: var(--foreground);
        cursor: pointer;
        transition: background-color .16s ease, color .16s ease, border-color .16s ease;
      }
      .btn-icon:hover {
        background: var(--accent);
        border-color: var(--border);
      }
      .btn-icon [data-icon] {
        width: 16px;
        height: 16px;
      }
      .btn-link {
        background: none;
        border: none;
        padding: 0;
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 500;
        color: var(--primary);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        text-decoration: none;
      }
      .btn-link:hover {
        color: var(--brand-600);
      }
      .btn-link [data-icon] {
        width: 14px;
        height: 14px;
      }

      /* ── Badges & Tags ───────────────────────────────────── */
      .sg-badge-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
      }
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        height: 24px;
        padding: 0 10px;
        border-radius: var(--radius-full);
        font-family: var(--font-sans);
        font-size: 11px;
        font-weight: 500;
        white-space: nowrap;
        border: 1px solid transparent;
      }
      .badge-collected {
        background: var(--info-50);
        color: var(--info-600);
        border-color: var(--info-200);
      }
      .badge-plan {
        background: var(--warning-50);
        color: var(--warning-600);
        border-color: var(--warning-200);
      }
      .badge-reading {
        background: var(--brand-50);
        color: var(--brand-600);
        border-color: var(--brand-200);
      }
      .badge-done {
        background: var(--success-50);
        color: var(--success-600);
        border-color: var(--success-200);
      }
      .badge-stored {
        background: var(--bg-300);
        color: var(--text-500);
        border-color: var(--border-200);
      }
      .tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        height: 26px;
        padding: 0 10px;
        border-radius: var(--radius-full);
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 400;
        background: var(--bg-300);
        color: var(--foreground);
        border: 1px solid transparent;
      }
      .tag-add {
        background: transparent;
        color: var(--muted-foreground);
        border: 1px dashed var(--border-400);
        cursor: pointer;
        padding: 0 10px;
        height: 26px;
        border-radius: var(--radius-full);
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }
      .tag-add:hover {
        border-color: var(--primary);
        color: var(--primary);
      }
      .tag-add [data-icon] {
        width: 12px;
        height: 12px;
      }
      .badge-purpose {
        background: var(--bg-300);
        color: var(--text-600);
        font-family: var(--font-sans);
        font-size: 11px;
        font-weight: 500;
        height: 22px;
        padding: 0 8px;
        border-radius: var(--radius-full);
        display: inline-flex;
        align-items: center;
      }
      .filter-pill {
        height: 30px;
        padding: 0 14px;
        border-radius: var(--radius-full);
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 500;
        border: 1px solid transparent;
        background: transparent;
        color: var(--muted-foreground);
        cursor: pointer;
        transition: all .16s ease;
        display: inline-flex;
        align-items: center;
      }
      .filter-pill:hover {
        background: var(--accent);
        color: var(--foreground);
      }
      .filter-pill.active {
        background: var(--primary);
        color: var(--primary-foreground);
      }
      .meta-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        height: 24px;
        padding: 0 10px;
        border-radius: var(--radius-full);
        font-family: var(--font-sans);
        font-size: 11px;
        font-weight: 500;
        background: var(--bg-300);
        color: var(--text-600);
      }
      .trace-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        height: 22px;
        padding: 0 8px;
        border-radius: var(--radius-full);
        font-family: var(--font-sans);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.02em;
      }
      .trace-badge-highlight {
        background: var(--brand-100);
        color: var(--brand-700);
      }
      .trace-badge-note {
        background: var(--success-100);
        color: var(--success-700);
      }
      .mark-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        height: 26px;
        padding: 0 10px;
        border-radius: var(--radius-sm);
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 400;
        background: var(--bg-200);
        color: var(--text-600);
      }

      /* ── Cards ───────────────────────────────────────────── */
      .sg-card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 20px;
      }
      .book-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        overflow: hidden;
        box-shadow: var(--shadow-xs);
        transition: box-shadow .16s ease;
      }
      .book-card:hover {
        box-shadow: var(--shadow-sm);
      }
      .book-card-cover {
        width: 100%;
        aspect-ratio: 3/4;
        background: var(--bg-400);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
      }
      .book-card-cover-text {
        font-family: var(--font-display);
        font-size: 16px;
        color: var(--text-500);
      }
      .book-card-body {
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .book-card-title {
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 600;
        color: var(--foreground);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .book-card-author {
        font-family: var(--font-serif);
        font-size: 12px;
        color: var(--muted-foreground);
      }
      .book-card-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .book-card-progress-bar {
        width: 100%;
        height: 4px;
        background: var(--bg-400);
        border-radius: var(--radius-full);
        overflow: hidden;
      }
      .book-card-progress-fill {
        height: 100%;
        background: var(--primary);
        border-radius: var(--radius-full);
      }

      /* Book card list view */
      .book-card-list {
        display: flex;
        gap: 14px;
        padding: 12px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-xs);
        align-items: center;
      }
      .book-card-list-thumb {
        width: 48px;
        height: 64px;
        border-radius: 4px;
        background: var(--bg-400);
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .book-card-list-thumb span {
        font-family: var(--font-display);
        font-size: 10px;
        color: var(--text-400);
      }
      .book-card-list-body {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 3px;
      }
      .book-card-list-title {
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 600;
        color: var(--foreground);
      }
      .book-card-list-author {
        font-family: var(--font-serif);
        font-size: 12px;
        color: var(--muted-foreground);
      }
      .book-card-list-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 4px;
        flex-shrink: 0;
      }

      /* Trace card */
      .trace-card {
        padding: 16px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        border-left: 3px solid var(--primary);
        box-shadow: var(--shadow-xs);
      }
      .trace-card-note {
        border-left-color: var(--success-500);
      }
      .trace-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
      }
      .trace-card-quote {
        font-family: var(--font-serif);
        font-size: 14px;
        line-height: 1.7;
        color: var(--foreground);
        margin-bottom: 10px;
        font-style: italic;
      }
      .trace-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-family: var(--font-sans);
        font-size: 11px;
        color: var(--muted-foreground);
      }

      /* Topic card */
      .topic-card {
        padding: 16px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-xs);
      }
      .topic-card-title {
        font-family: var(--font-sans);
        font-size: 14px;
        font-weight: 600;
        color: var(--foreground);
        margin: 0 0 6px;
      }
      .topic-card-desc {
        font-family: var(--font-serif);
        font-size: 13px;
        color: var(--muted-foreground);
        margin: 0 0 12px;
        line-height: 1.5;
      }
      .topic-card-books {
        display: flex;
        gap: 6px;
        margin-top: 12px;
      }
      .topic-card-book-thumb {
        width: 32px;
        height: 42px;
        border-radius: 3px;
        background: var(--bg-400);
        border: 1px solid var(--border-200);
      }

      /* Stat card (lightweight) */
      .stat-light {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 80px;
      }
      .stat-light-num {
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 28px;
        color: var(--foreground);
        line-height: 1.1;
        font-variant-numeric: tabular-nums;
      }
      .stat-light-label {
        font-family: var(--font-sans);
        font-size: 12px;
        color: var(--muted-foreground);
      }

      /* Content card */
      .content-card {
        padding: 20px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-xs);
      }
      .content-card-title {
        font-family: var(--font-sans);
        font-size: 14px;
        font-weight: 600;
        color: var(--foreground);
        margin: 0 0 16px;
      }

      /* ── Stars / Rating ──────────────────────────────────── */
      .star-row {
        display: flex;
        gap: 2px;
      }
      .star {
        width: 16px;
        height: 16px;
        color: var(--muted-foreground);
      }
      .star.filled {
        color: var(--primary);
      }
      .sg-rating-group {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      /* ── Progress ────────────────────────────────────────── */
      .progress-bar {
        width: 100%;
        height: 4px;
        background: var(--bg-400);
        border-radius: var(--radius-full);
        overflow: hidden;
      }
      .progress-bar-fill {
        height: 100%;
        background: var(--primary);
        border-radius: var(--radius-full);
        transition: width .3s ease;
      }
      .progress-bar-wide {
        height: 6px;
      }
      .progress-bar-wide .progress-bar-fill {
        height: 100%;
      }
      .progress-bar-label {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--muted-foreground);
        margin-top: 4px;
      }

      /* ── Nav samples ────────────────────────────────────── */
      .sg-nav-sidebar-sample {
        width: 256px;
        background: var(--sidebar);
        border: 1px solid var(--sidebar-border);
        border-radius: var(--radius-md);
        padding: 8px;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .sg-nav-sidebar-sample .sg-nav-label {
        font-family: var(--font-sans);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted-foreground);
        padding: 8px 12px 4px;
      }
      .sg-nav-sidebar-sample .sg-nav-sample-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border: 1px solid transparent;
        border-radius: calc(var(--radius) - 8px);
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 500;
        color: var(--sidebar-foreground);
        text-decoration: none;
      }
      .sg-nav-sidebar-sample .sg-nav-sample-item:hover {
        background: var(--sidebar-accent);
      }
      .sg-nav-sidebar-sample .sg-nav-sample-item.active {
        background: var(--primary);
        color: var(--primary-foreground);
        box-shadow: var(--shadow-xs);
      }
      .sg-nav-sidebar-sample .sg-nav-sample-item [data-icon] {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
      }

      /* Mobile bottom tab sample */
      .sg-mobile-tabs-sample {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 4px;
        width: min(100%, 320px);
        padding: 8px;
        background: var(--sidebar);
        border: 1px solid var(--sidebar-border);
        border-radius: var(--radius-md);
      }
      .sg-mobile-tab-sample {
        display: grid;
        gap: 3px;
        justify-items: center;
        padding: 8px 4px;
        border: none;
        border-radius: calc(var(--radius) - 6px);
        background: transparent;
        color: var(--sidebar-foreground);
        font-family: var(--font-sans);
        font-size: 11px;
        font-weight: 500;
      }
      .sg-mobile-tab-sample.active {
        color: var(--primary);
      }
      .sg-mobile-tab-sample [data-icon] {
        width: 20px;
        height: 20px;
      }

      /* Breadcrumb */
      .sg-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-family: var(--font-sans);
        font-size: 12px;
        color: var(--muted-foreground);
      }
      .sg-breadcrumb a {
        color: var(--muted-foreground);
        text-decoration: none;
      }
      .sg-breadcrumb a:hover {
        color: var(--primary);
      }
      .sg-breadcrumb .sg-breadcrumb-sep {
        color: var(--text-400);
      }
      .sg-breadcrumb .sg-breadcrumb-current {
        color: var(--foreground);
        font-weight: 500;
      }
      .sg-breadcrumb-sep [data-icon] {
        width: 12px;
        height: 12px;
      }

      /* Tab bar */
      .sg-tab-bar {
        display: flex;
        gap: 4px;
        border-bottom: 1px solid var(--border);
        padding-bottom: 0;
      }
      .sg-tab-item {
        padding: 10px 16px;
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 500;
        color: var(--muted-foreground);
        border: none;
        background: none;
        cursor: pointer;
        position: relative;
      }
      .sg-tab-item:hover {
        color: var(--foreground);
      }
      .sg-tab-item.active {
        color: var(--primary);
      }
      .sg-tab-item.active::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 0;
        right: 0;
        height: 2px;
        background: var(--primary);
        border-radius: 1px;
      }

      /* ── Data display ───────────────────────────────────── */
      .sg-stat-row {
        display: flex;
        flex-wrap: wrap;
        gap: 32px;
        align-items: center;
      }
      .sg-stat-row-item {
        display: flex;
        align-items: baseline;
        gap: 6px;
      }
      .sg-stat-row-num {
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 20px;
        color: var(--foreground);
        font-variant-numeric: tabular-nums;
      }
      .sg-stat-row-label {
        font-family: var(--font-sans);
        font-size: 12px;
        color: var(--muted-foreground);
      }

      /* File list row */
      .file-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
      }
      .file-row-icon [data-icon] {
        width: 20px;
        height: 20px;
        color: var(--muted-foreground);
      }
      .file-row-name {
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 500;
        color: var(--foreground);
        flex: 1;
      }
      .file-row-meta {
        display: flex;
        align-items: center;
        gap: 12px;
        font-family: var(--font-sans);
        font-size: 11px;
        color: var(--muted-foreground);
      }
      .file-row-actions {
        display: flex;
        gap: 4px;
      }
      .file-row-actions .btn-icon {
        width: 30px;
        height: 30px;
      }
      .file-row-actions .btn-icon [data-icon] {
        width: 14px;
        height: 14px;
      }

      /* Heatmap */
      .sg-heatmap {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 4px;
        width: fit-content;
      }
      .sg-heatmap-cell {
        width: 16px;
        height: 16px;
        border-radius: 3px;
        background: var(--bg-400);
      }
      .sg-heatmap-cell.l1 { background: var(--brand-100); }
      .sg-heatmap-cell.l2 { background: var(--brand-200); }
      .sg-heatmap-cell.l3 { background: var(--brand-400); }
      .sg-heatmap-cell.l4 { background: var(--brand-600); }

      /* Table */
      .sg-table {
        width: 100%;
        border-collapse: collapse;
        font-family: var(--font-sans);
        font-size: 13px;
      }
      .sg-table th {
        text-align: left;
        padding: 10px 14px;
        font-weight: 600;
        font-size: 11px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--muted-foreground);
        border-bottom: 1px solid var(--border);
        background: var(--bg-200);
      }
      .sg-table td {
        padding: 10px 14px;
        color: var(--foreground);
        border-bottom: 1px solid var(--border-100);
      }
      .sg-table tr:last-child td {
        border-bottom: none;
      }
      .sg-table .sg-table-num {
        font-variant-numeric: tabular-nums;
      }

      /* ── Reader components ─────────────────────────────── */
      .sg-reader-text {
        font-family: var(--font-serif);
        font-size: 16px;
        line-height: 1.8;
        color: var(--foreground);
        max-width: 520px;
      }
      .sg-highlight {
        background: var(--brand-100);
        border-radius: 2px;
        padding: 1px 3px;
        position: relative;
      }
      .sg-highlight-annotation {
        position: relative;
        display: inline;
      }
      .sg-highlight-popup {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        background: var(--popover);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 10px 12px;
        box-shadow: var(--shadow-md);
        width: 240px;
        z-index: 10;
      }
      .sg-highlight-popup-text {
        font-family: var(--font-serif);
        font-size: 12px;
        color: var(--foreground);
        line-height: 1.5;
        margin-bottom: 6px;
      }
      .sg-highlight-popup-meta {
        font-family: var(--font-sans);
        font-size: 10px;
        color: var(--muted-foreground);
      }
      .sg-underline {
        text-decoration: underline;
        text-decoration-color: var(--brand-400);
        text-underline-offset: 3px;
      }
      .sg-bookmark-edge {
        position: relative;
        display: inline-block;
      }
      .sg-bookmark-edge::after {
        content: '';
        position: absolute;
        top: -2px;
        right: -16px;
        width: 10px;
        height: 20px;
        background: var(--primary);
        clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 75%, 0 100%);
      }

      /* Selection popup */
      .sg-selection-popup {
        display: inline-flex;
        gap: 2px;
        padding: 4px;
        background: var(--popover);
        border: 1px solid var(--border);
        border-radius: var(--radius-full);
        box-shadow: var(--shadow-md);
      }
      .sg-selection-popup button {
        height: 30px;
        padding: 0 14px;
        border: none;
        border-radius: var(--radius-full);
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 500;
        background: transparent;
        color: var(--foreground);
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .sg-selection-popup button:hover {
        background: var(--accent);
      }
      .sg-selection-popup button [data-icon] {
        width: 14px;
        height: 14px;
      }

      /* Note panel item */
      .sg-note-item {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 14px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-xs);
        max-width: 380px;
      }
      .sg-note-text {
        font-family: var(--font-serif);
        font-size: 13px;
        line-height: 1.6;
        color: var(--foreground);
    }
      .sg-note-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-family: var(--font-sans);
        font-size: 11px;
        color: var(--muted-foreground);
