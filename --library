<script>
  // ── Dark mode toggle ────────────────────────────────────
  const themeToggle = document.getElementById('theme-toggle');
  const html = document.documentElement;

  function applyTheme(dark) {
    html.classList.toggle('dark', dark);
    localStorage.setItem('redesk-theme', dark ? 'dark' : 'light');
    // Update toggle icon & label
    const icon = themeToggle.querySelector('[data-icon]');
    const label = themeToggle.querySelector('span:last-child');
    if (dark) {
      icon.style.cssText = "width:18px;height:18px;-webkit-mask-image:url('../assets/icons/dl-builtin-claude/circle-play.svg');mask-image:url('../assets/icons/dl-builtin-claude/circle-play.svg')";
      label.textContent = '浅色模式';
    } else {
      icon.style.cssText = "width:18px;height:18px;-webkit-mask-image:url('../assets/icons/dl-builtin-claude/circle-play.svg');mask-image:url('../assets/icons/dl-builtin-claude/circle-play.svg')";
      label.textContent = '深色模式';
    }
  }

  // Restore saved theme
  const savedTheme = localStorage.getItem('redesk-theme');
  if (savedTheme === 'dark') {
    applyTheme(true);
  }

  themeToggle.addEventListener('click', (e) => {
    e.preventDefault();
    applyTheme(!html.classList.contains('dark'));
  });

  // ── Mobile sidebar toggle ─────────────────────────────────
  const sidebar = document.getElementById('sidebar');
  const backdrop = document.getElementById('sidebar-backdrop');

  backdrop.addEventListener('click', () => {
    sidebar.classList.remove('is-open');
    backdrop.classList.remove('is-visible');
  });
</script>


