      .sg-note-actions .btn-icon [data-icon] {
        width: 13px;
        height: 13px;
      }

      /* Shortcut hint */
      .sg-shortcut {
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--muted-foreground);
        background: var(--bg-300);
        border: 1px solid var(--border-200);
        border-radius: 4px;
        padding: 1px 5px;
        margin-top: 2px;
      }

      /* ── Toast / Feedback ────────────────────────────────── */
      .sg-toast {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        border-radius: var(--radius-md);
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 500;
        box-shadow: var(--shadow-md);
        max-width: 320px;
