        gap: 3px;
      }
      .rp-heatmap-cell {
        width: 14px;
        height: 14px;
        border-radius: 3px;
        background: var(--bg-300);
      }
      .rp-heatmap-cell.level-1 { background: var(--brand-100); }
      .rp-heatmap-cell.level-2 { background: var(--brand-200); }
      .rp-heatmap-cell.level-3 { background: var(--brand-400); }
      .rp-heatmap-cell.level-4 { background: var(--brand-500); }

      /* Heatmap Legend */
      .rp-heatmap-legend {
        display: flex;
        gap: 12px;
        margin-top: 12px;
        align-items: center;
      }
      .rp-heatmap-legend-item {
        display: flex;
        align-items: center;
        gap: 4px;
        font-family: var(--font-sans);
        font-size: 11px;
        color: var(--muted-foreground);
      }

      /* ── Donut Chart (Time-of-day) ────────────────────────── */
      .rp-donut-wrap-new {
        display: flex;
        justify-content: center;
        padding: 8px 0;
      }
      .rp-donut-chart {
        width: 140px;
        height: 140px;
      }
      .rp-donut-legend-new {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px 16px;
        margin-top: 12px;
      }
      .rp-donut-legend-row {
        display: flex;
        align-items: center;
        gap: 6px;
        font-family: var(--font-sans);
        font-size: 12px;
        color: var(--foreground);
      }
      .rp-donut-legend-dot {
        width: 8px;
        height: 8px;
        border-radius: 3px;
        flex-shrink: 0;
      }
      .rp-donut-legend-val {
        margin-left: auto;
        font-weight: 600;
        font-size: 12px;
        color: var(--muted-foreground);
        font-variant-numeric: tabular-nums;
      }

      /* ── Horizontal Bar Chart (Categories) ────────────────── */
      .rp-cat-horiz {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .rp-cat-horiz-row {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .rp-cat-horiz-label {
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 500;
        color: var(--foreground);
        width: 36px;
        flex-shrink: 0;
      }
      .rp-cat-horiz-track {
        flex: 1;
        height: 10px;
        background: var(--muted);
        border-radius: var(--radius-full);
        overflow: hidden;
      }
      .rp-cat-horiz-fill {
        height: 100%;
        border-radius: var(--radius-full);
        background: var(--brand-500);
      }
      .rp-cat-horiz-count {
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 600;
        color: var(--foreground);
        width: 24px;
        text-align: right;
        flex-shrink: 0;
        font-variant-numeric: tabular-nums;
      }

      /* ── Currently Reading + Recent Sessions ────────────────── */
      .rp-reading-now {
        margin-bottom: 16px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--border);
      }
      .rp-reading-now-card {
        display: flex;
        align-items: center;
        gap: 14px;
      }
      .rp-reading-now-cover {
        width: 44px;
        height: 60px;
        border-radius: var(--radius-sm);
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .rp-reading-now-cover span {
        font-family: var(--font-serif);
        font-size: 8px;
        color: var(--text-600);
        text-align: center;
        padding: 2px;
      }
      .rp-reading-now-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 3px;
      }
      .rp-reading-now-title {
        font-family: var(--font-serif);
        font-size: 14px;
        font-weight: 600;
        color: var(--foreground);
      }
      .rp-reading-now-author {
        font-family: var(--font-sans);
        font-size: 11px;
        color: var(--muted-foreground);
      }
      .rp-reading-now-progress {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 2px;
      }
      .rp-reading-now-track {
        flex: 1;
        height: 6px;
        background: var(--muted);
        border-radius: var(--radius-full);
        overflow: hidden;
      }
      .rp-reading-now-fill {
        height: 100%;
        border-radius: var(--radius-full);
        background: var(--brand-500);
      }
      .rp-reading-now-pct {
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 600;
        color: var(--brand-500);
        flex-shrink: 0;
      }
      .rp-reading-now-meta {
        font-family: var(--font-sans);
        font-size: 11px;
        color: var(--muted-foreground);
      }

      /* ── Recent Sessions List ──────────────────────────────── */
      .rp-recent-sessions .rp-panel-title {
        margin-top: 0;
      }
      .rp-recent-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0;
      }
      .rp-recent-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid var(--border);
      }
      .rp-recent-item:last-child {
        border-bottom: none;
      }
      .rp-recent-title {
        font-family: var(--font-serif);
        font-size: 13px;
        color: var(--foreground);
      }
      .rp-recent-dur {
        font-family: var(--font-sans);
        font-size: 11px;
        color: var(--muted-foreground);
        flex-shrink: 0;
      }

      /* ── Want vs Actual ─────────────────────────────────────── */
      .rp-compare-wrap {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }
      .rp-compare-row {
        display: flex;
        align-items: center;
        gap: 16px;
      }
      .rp-compare-label {
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 500;
        color: var(--foreground);
        width: 48px;
        flex-shrink: 0;
      }
      .rp-compare-bar-track {
        flex: 1;
        height: 24px;
        background: var(--muted);
        border-radius: var(--radius-sm);
        overflow: hidden;
      }
      .rp-compare-bar-fill {
        height: 100%;
        border-radius: var(--radius-sm);
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding-right: 10px;
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 600;
        color: #fff;
      }
      .rp-compare-bar-fill.want {
        background: var(--text-400);
        width: 100%;
      }
      .rp-compare-bar-fill.done {
        background: var(--brand-500);
        width: 69.4%;
      }

      /* ── Responsive adjustments ─────────────────────────────── */
      @media (max-width: 1024px) {
        .rp-stats-grid {
          grid-template-columns: repeat(3, 1fr);
        }
        .rp-row-2cols {
          grid-template-columns: 1fr;
        }
        .rp-grid-4 {
          grid-template-columns: 1fr;
        }
      }
      @media (max-width: 768px) {
        .rp-stats-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .rp-page {
          gap: 16px;
        }
      }

      /* ── Dark Mode Overrides ──────────────────────────────────── */
      html.dark .shell-sidebar-backdrop,
      .dark .shell-sidebar-backdrop {
        background: rgba(0, 0, 0, 0.6);
      }

      html.dark .shell-mobile-tabs,
      .dark .shell-mobile-tabs {
        box-shadow: 0 -1px 3px 0 rgba(0, 0, 0, 0.3);
      }
    </style>
</body>
</html>

