# Redesk 本地开发环境配置示例
# 复制为 .env 并填写真实值；.env 不入库。

# 运行模式
NODE_ENV=development

# 后端
API_HOST=0.0.0.0
API_PORT=8787
API_BASE_URL=http://localhost:8787
LOG_LEVEL=info

# 数据库与存储
DATABASE_URL=./data/redesk.db
STORAGE_DIR=./data/storage
SPA_DIR=./apps/web/dist

# 会话（生产环境务必改为强随机字符串，建议 32+ 字节）
SESSION_SECRET=change-me-to-a-long-random-string

# 跨域（CORS allowlist 之外会失败）
WEB_URL=http://localhost:5173

# 前端（Vite dev server）
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8787/api/v1
# 本地开发默认免登录；设为 false 可恢复登录/初始化页
VITE_AUTH_DISABLED=true
# 后端也支持 AUTH_DISABLED 强制开关（生产部署建议显式置 false）
# AUTH_DISABLED=false

# 初始账户引导（首次启动若无账户时使用，可选）
# 适用场景：单口令模式（settings.auth_mode != 'multi_token'）+ 首次启动数据库为空
# 不设置则使用硬编码默认值 username=admin / password=redesk，**生产部署强烈建议设置**。
# 设置后：
#   1. 首次启动时数据库会自动创建该账户
#   2. 已存在的账户不会被覆盖（不会自动改密）
#   3. 部署完成后请登录并修改密码
# BOOTSTRAP_USERNAME=admin
# BOOTSTRAP_PASSWORD=replace-with-a-strong-passphrase-at-least-8-chars

# 云存储（Cloudflare R2 / S3 兼容）
# 不在此处配置。运行时通过「设置 → 云存储」页填写。
# 数据存 SQLite settings 表（key 前缀 oss_*），重启后端生效。

# LLM / AI（可选，用于未来功能）
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
