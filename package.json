{
  "name": "redesk",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "description": "自托管个人阅读管理与 AI 陪读系统",
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @redesk/api --filter @redesk/web dev",
    "dev:api": "pnpm --filter @redesk/api dev",
    "dev:web": "pnpm --filter @redesk/web dev",
    "build": "pnpm --filter @redesk/shared build && pnpm --filter @redesk/db build && pnpm --filter @redesk/api build && pnpm --filter @redesk/web build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @redesk/db generate",
    "db:migrate": "pnpm --filter @redesk/db migrate",
    "db:seed": "pnpm --filter @redesk/db seed",
    "bump": "node scripts/bump-version.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
